                            }
                        }
                    ],
                    "request": {
                        "auth": { "type": "noauth" },
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/gifts/{{giftId}}",
                            "host": ["{{baseUrl}}"],
                            "path": ["gifts", "{{giftId}}"]
                        }
                    }
