{
    "info": {
        "_postman_id": "b1a2c3d4-e5f6-7890-abcd-ef1234567890",
        "name": "RGB Backend Test",
        "description": "Rolling Glory Backend Web Developer Test — Gift Redemption REST API.\n\n**Setup:**\n1. Set env variable `baseUrl` (default: `http://localhost:3000/api`).\n2. Run `Auth > Login (Admin)` — `accessToken` otomatis disimpan di collection variable.\n3. Endpoint lain akan otomatis pakai Bearer token tersebut.\n4. Untuk endpoint yang butuh `:id`, isi collection variable `giftId` / `userId` atau override di request.\n\n**Default admin credential** (dari seeder):\n- username: `admin`\n- password: `admin123`",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            { "key": "token", "value": "{{accessToken}}", "type": "string" }
        ]
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:3000/api",
            "type": "string"
        },
        { "key": "accessToken", "value": "", "type": "string" },
        { "key": "giftId", "value": "", "type": "string" },
        { "key": "userId", "value": "", "type": "string" }
    ],
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Login (Admin)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const res = pm.response.json();",
                                    "const token = res?.data?.attributes?.accessToken;",
                                    "const userId = res?.data?.id;",
                                    "if (token) {",
                                    "    pm.collectionVariables.set('accessToken', token);",
                                    "    console.log('accessToken saved to collection variables');",
                                    "}",
                                    "if (userId) {",
                                    "    pm.collectionVariables.set('userId', userId);",
                                    "}",
                                    "pm.test('status 200/201', () => pm.expect([200,201]).to.include(pm.response.code));",
                                    "pm.test('has access token', () => pm.expect(token).to.be.a('string'));"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "auth": { "type": "noauth" },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "raw",
                            "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/login",
                            "host": ["{{baseUrl}}"],
                            "path": ["login"]
                        },
                        "description": "Login, auto-save `accessToken` dan `userId` ke collection variables."
                    }
                }
            ]
        },
        {
            "name": "Gifts (Public)",
            "item": [
                {
                    "name": "List gifts",
                    "request": {
                        "auth": { "type": "noauth" },
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/gifts?page=1&limit=10&sortBy=newest&order=DESC",
                            "host": ["{{baseUrl}}"],
                            "path": ["gifts"],
                            "query": [
                                { "key": "page", "value": "1" },
                                { "key": "limit", "value": "10" },
                                {
                                    "key": "sortBy",
                                    "value": "newest",
                                    "description": "newest | rating"
                                },
                                {
                                    "key": "order",
                                    "value": "DESC",
                                    "description": "ASC | DESC"
                                },
                                {
                                    "key": "minRating",
                                    "value": "4",
                                    "disabled": true,
                                    "description": "0..5 (Rating X ke atas)"
                                },
                                {
                                    "key": "inStock",
                                    "value": "true",
                                    "disabled": true,
                                    "description": "true | false (Stock Tersedia)"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "List gifts (Rating 4 ke atas + Stock Tersedia)",
                    "request": {
                        "auth": { "type": "noauth" },
                        "method": "GET",
                        "header": [],
                        "url": {
                            "raw": "{{baseUrl}}/gifts?page=1&limit=10&sortBy=rating&order=DESC&minRating=4&inStock=true",
                            "host": ["{{baseUrl}}"],
                            "path": ["gifts"],
                            "query": [
                                { "key": "page", "value": "1" },
                                { "key": "limit", "value": "10" },
                                { "key": "sortBy", "value": "rating" },
                                { "key": "order", "value": "DESC" },
                                { "key": "minRating", "value": "4" },
                                { "key": "inStock", "value": "true" }
                            ]
                        },
                        "description": "Contoh filter sesuai wireframe: Rating 4 ke atas, Stock Tersedia, sort by rating DESC."
                    }
                },
                {
                    "name": "Get gift by id",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
